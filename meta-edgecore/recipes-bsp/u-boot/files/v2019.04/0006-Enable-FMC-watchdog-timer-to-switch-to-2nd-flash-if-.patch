From 613727afa5b99c79233a52e8e837ecee6fd2ea7d Mon Sep 17 00:00:00 2001
From: simon_fan <simon_fan@edge-core.com>
Date: Fri, 5 Feb 2021 09:26:19 +0800
Subject: [PATCH] 1. Enable FMC watchdog timer to switch to 2nd flash before
 loading OS
     2. Disable FMC watchdog timer when abort

---
 common/bootm.c    | 10 ++++++++
 common/autoboot.c | 10 ++++++++++
 2 file changed, 18 insertions(+)

diff --git a/common/bootm.c b/common/bootm.c
index 3adbceaa38..f267d2c661 100644
--- a/common/bootm.c
+++ b/common/bootm.c
@@ -24,6 +24,9 @@
 #else
 #include "mkimage.h"
 #endif
+#ifdef CONFIG_FMC_DUAL_BOOT
+#include <asm/arch/fmc_dual_boot_ast2600.h>
+#endif
 
 #include <command.h>
 #include <bootm.h>
@@ -88,6 +91,13 @@ static int bootm_find_os(cmd_tbl_t *cmdtp, int flag, int argc,
 	bool ep_found = false;
 	int ret;
 
+#ifdef CONFIG_FMC_DUAL_BOOT
+	if( !(readl(ASPEED_FMC_WDT2) & BIT(4)) ){ /* only primary flash need trigger FMC wdt */
+		fmc_enable_dual_boot(120);
+		printf("Enable FMC Wdt to 120 seconds\n");
+	}
+#endif
+
 	/* get kernel image header, start address and length */
 	os_hdr = boot_get_kernel(cmdtp, flag, argc, argv,
 			&images, &images.os.image_start, &images.os.image_len);
diff --git a/common/autoboot.c b/common/autoboot.c
index 94133eaeda..1d365e773d 100644
--- a/common/autoboot.c
+++ b/common/autoboot.c
@@ -14,6 +14,9 @@
 #include <post.h>
 #include <u-boot/sha256.h>
 #include <bootcount.h>
+#ifdef CONFIG_FMC_DUAL_BOOT
+#include <asm/arch/fmc_dual_boot_ast2600.h>
+#endif
 
 DECLARE_GLOBAL_DATA_PTR;
 
@@ -267,6 +270,15 @@ static int abortboot(int bootdelay)
 		gd->flags &= ~GD_FLG_SILENT;
 #endif
 
+	if( abort ){
+#ifdef CONFIG_FMC_DUAL_BOOT
+		if( !(readl(ASPEED_FMC_WDT2) & BIT(4)) ){ /* only primary flash need stop FMC wdt */
+			fmc_disable_dual_boot_wtd();
+			printf("Disable FMC Wdt timer.\n");
+		}
+#endif
+	}
+
 	return abort;
 }
 
-- 
