From a1c06025e61ec25c81a21bb4184dc05360e1f5a5 Mon Sep 17 00:00:00 2001
From: simon_fan <simon_fan@edge-core.com>
Date: Thu, 24 Mar 2022 15:21:58 +0800
Subject: [PATCH] Change cputemp retry to workque

---
 drivers/hwmon/peci-cputemp.c  | 96 ++++++++++++++++++++++++++++-------
 drivers/hwmon/peci-dimmtemp.c |  2 +-
 2 files changed, 79 insertions(+), 19 deletions(-)

diff --git a/drivers/hwmon/peci-cputemp.c b/drivers/hwmon/peci-cputemp.c
index b9fe91281d58..2bd35acdf15b 100644
--- a/drivers/hwmon/peci-cputemp.c
+++ b/drivers/hwmon/peci-cputemp.c
@@ -7,12 +7,16 @@
 #include <linux/module.h>
 #include <linux/of_device.h>
 #include <linux/platform_device.h>
+#include <linux/workqueue.h>
 #include "peci-hwmon.h"
 
 #define DEFAULT_CHANNEL_NUMS	5
 #define CORETEMP_CHANNEL_NUMS	CORE_NUMS_MAX
 #define CPUTEMP_CHANNEL_NUMS	(DEFAULT_CHANNEL_NUMS + CORETEMP_CHANNEL_NUMS)
 
+#define CPU_MASK_CHECK_DELAY_JIFFIES   msecs_to_jiffies(5000)
+#define CPU_MASK_CHECK_RETRY_MAX       60 /* 60 x 5 secs = 5 minutes */
+
 struct temp_group {
 	struct peci_sensor_data		die;
 	struct peci_sensor_data		dts;
@@ -27,8 +31,11 @@ struct peci_cputemp {
 	struct device			*dev;
 	char				name[PECI_NAME_SIZE];
 	const struct cpu_gen_info	*gen_info;
+	struct workqueue_struct		*work_queue;
+	struct delayed_work		work_handler;
 	struct temp_group		temp;
 	u64				core_mask;
+	int				retry_count;
 	u32				temp_config[CPUTEMP_CHANNEL_NUMS + 1];
 	uint				config_idx;
 	struct hwmon_channel_info	temp_info;
@@ -371,10 +378,27 @@ static int create_core_temp_label(struct peci_cputemp *priv, int idx)
 static int create_core_temp_info(struct peci_cputemp *priv)
 {
 	int ret, i;
+	struct device *dev;
 
 	ret = check_resolved_cores(priv);
-	if (ret)
+	if (ret) {
+		if (ret == -EAGAIN) {
+			if (priv->retry_count < CPU_MASK_CHECK_RETRY_MAX) {
+				queue_delayed_work(priv->work_queue,
+						   &priv->work_handler,
+						CPU_MASK_CHECK_DELAY_JIFFIES);
+				priv->retry_count++;
+				dev_dbg(priv->dev,
+					"Deferred CPU temp info creation\n");
+			} else {
+				dev_err(priv->dev,
+					"Timeout CPU temp info creation\n");
+				ret = -ETIMEDOUT;
+			}
+		}
+
 		return ret;
+	}
 
 	priv->coretemp_label = devm_kzalloc(priv->dev,
 					    priv->gen_info->core_max *
@@ -394,15 +418,47 @@ static int create_core_temp_info(struct peci_cputemp *priv)
 				return ret;
 		}
 
+	priv->chip.ops = &cputemp_ops;
+	priv->chip.info = priv->info;
+
+	priv->info[0] = &priv->temp_info;
+
+	priv->temp_info.type = hwmon_temp;
+	priv->temp_info.config = priv->temp_config;
+
+	dev = devm_hwmon_device_register_with_info(priv->dev,
+						   priv->name,
+						   priv,
+						   &priv->chip,
+						   NULL);
+
+	if (IS_ERR(dev)){
+		dev_err(priv->dev, "Failed to register hwmon device\n");
+		return PTR_ERR(dev);
+	}
+
+	dev_info(dev, "%s: sensor '%s', retry %d times\n", dev_name(dev), priv->name, priv->retry_count);
+
 	return 0;
 }
 
+static void create_core_temp_info_delayed(struct work_struct *work)
+{
+	struct delayed_work *dwork = to_delayed_work(work);
+	struct peci_cputemp *priv = container_of(dwork, struct peci_cputemp,
+						 work_handler);
+	int ret;
+
+	ret = create_core_temp_info(priv);
+	if (ret && ret != -EAGAIN)
+		dev_dbg(priv->dev, "Failed to create CPU temp info\n");
+}
+
 static int peci_cputemp_probe(struct platform_device *pdev)
 {
 	struct peci_client_manager *mgr = dev_get_drvdata(pdev->dev.parent);
 	struct device *dev = &pdev->dev;
 	struct peci_cputemp *priv;
-	struct device *hwmon_dev;
 	int ret;
 
 	if ((mgr->client->adapter->cmd_mask &
@@ -428,28 +484,31 @@ static int peci_cputemp_probe(struct platform_device *pdev)
 	priv->temp_config[priv->config_idx++] = config_table[channel_tthrottle];
 	priv->temp_config[priv->config_idx++] = config_table[channel_tjmax];
 
-	ret = create_core_temp_info(priv);
-	if (ret)
-		dev_dbg(dev, "Skipped creating core temp info\n");
+	priv->work_queue = alloc_ordered_workqueue(priv->name, 0);
+	if (!priv->work_queue)
+		return -ENOMEM;
 
-	priv->chip.ops = &cputemp_ops;
-	priv->chip.info = priv->info;
+	INIT_DELAYED_WORK(&priv->work_handler, create_core_temp_info_delayed);
 
-	priv->info[0] = &priv->temp_info;
+	ret = create_core_temp_info(priv);
+	if (ret && ret != -EAGAIN) {
+		dev_dbg(dev, "Failed to create CPU temp info\n");
+		goto err_free_wq;
+	}
 
-	priv->temp_info.type = hwmon_temp;
-	priv->temp_info.config = priv->temp_config;
+	return 0;
 
-	hwmon_dev = devm_hwmon_device_register_with_info(priv->dev,
-							 priv->name,
-							 priv,
-							 &priv->chip,
-							 NULL);
+err_free_wq:
+	destroy_workqueue(priv->work_queue);
+	return ret;
+}
 
-	if (IS_ERR(hwmon_dev))
-		return PTR_ERR(hwmon_dev);
+static int peci_cputemp_remove(struct platform_device *pdev)
+{
+	struct peci_cputemp *priv = dev_get_drvdata(&pdev->dev);
 
-	dev_dbg(dev, "%s: sensor '%s'\n", dev_name(hwmon_dev), priv->name);
+	cancel_delayed_work_sync(&priv->work_handler);
+	destroy_workqueue(priv->work_queue);
 
 	return 0;
 }
@@ -462,6 +521,7 @@ MODULE_DEVICE_TABLE(platform, peci_cputemp_ids);
 
 static struct platform_driver peci_cputemp_driver = {
 	.probe		= peci_cputemp_probe,
+	.remove		= peci_cputemp_remove,
 	.id_table	= peci_cputemp_ids,
 	.driver		= { .name = KBUILD_MODNAME, },
 };
diff --git a/drivers/hwmon/peci-dimmtemp.c b/drivers/hwmon/peci-dimmtemp.c
index f59af419193d..12aa4acc9420 100644
--- a/drivers/hwmon/peci-dimmtemp.c
+++ b/drivers/hwmon/peci-dimmtemp.c
@@ -333,7 +333,7 @@ static int create_dimm_temp_info(struct peci_dimmtemp *priv)
 		return PTR_ERR(dev);
 	}
 
-	dev_dbg(priv->dev, "%s: sensor '%s'\n", dev_name(dev), priv->name);
+	dev_info(priv->dev, "%s: sensor '%s', retry %d times.\n", dev_name(dev), priv->name, priv->retry_count);
 
 	return 0;
 }
-- 
2.20.1

