&i2c4 {
	status = "okay";

	i2c-mux1@71 {
		compatible = "nxp,pca9548";
		i2c-mux-idle-disconnect;
		reg = <0x71>;

		i2c4_71_chan0: i2c@0 {
			reg = <0>;
			cpld1@system_cpld_6a {
				compatible = "edge-core,ec_system_cpld1";
				reg = <0x6a>;
			};			
		};

		i2c4_71_chan1: i2c@1 {
			reg = <1>;
			cpld2@system_cpld_6b {
				compatible = "edge-core,ec_system_cpld2";
				reg = <0x6b>;
			};			
		};

		i2c4_71_chan2: i2c@2 {
			reg = <2>;
			cpld3@system_cpld_6c {
				compatible = "edge-core,ec_system_cpld3";
				reg = <0x6c>;
			};			
		};

		i2c4_71_chan3: i2c@3 {
			reg = <3>;
		};

		i2c4_71_chan4: i2c@4 {
			reg = <4>;
		};

		i2c4_71_chan5: i2c@5 {
			reg = <5>;
		};

		i2c4_71_chan6: i2c@6 {
			reg = <6>;
		};

		i2c4_71_chan7: i2c@7 {
			reg = <7>;
		};
	};
};

&i2c4_71_chan5 {
	i2c-mux2@73 {
		compatible = "nxp,pca9548";
		i2c-mux-idle-disconnect;
		reg = <0x73>;

		i2c4_71_73_chan0: i2c@0 {
			reg = <0>;
		};

		i2c4_71_73_chan1: i2c@1 {
			reg = <1>;
			sensor9@fan_temp1_4d {
				//compatible = "national,lm75";
				reg = <0x4d>;
			};

			sensor10@fan_temp2_4e {
				//compatible = "national,lm75";
				reg = <0x4e>;
			};

			sensor13@fan_cpld_68 {
				compatible = "edge-core,ec_fan_cpld1";
				reg = <0x68>;
			};
		};

		i2c4_71_73_chan2: i2c@2 {
			reg = <2>;
		};

		i2c4_71_73_chan3: i2c@3 {
			reg = <3>;

			sensor4@lm75db_4b {
				//compatible = "national,lm75";
				reg = <0x4b>;
			};
		};

		i2c4_71_73_chan4: i2c@4 {
			reg = <4>;
		};

		i2c4_71_73_chan5: i2c@5 {
			reg = <5>;

			sensor5@88470_thermal_4c {
				//compatible = "national,lm75";
				reg = <0x4c>;
			};
		};

		i2c4_71_73_chan6: i2c@6 {
			reg = <6>;

			sensor6@lm75bd_1_4a {
				//compatible = "national,lm75";
				reg = <0x4a>;
			};

			sensor7@lm75bd_2_49 {
				//compatible = "national,lm75";
				reg = <0x49>;
			};

			sensor8@lm75bd_3_4e {
				//compatible = "national,lm75";
				reg = <0x4e>;
			};
		};

		i2c4_71_73_chan7: i2c@7 {
			reg = <7>;
		};
	};
};

&i2c4_71_chan6 {
	i2c-mux3@74 {
		compatible = "nxp,pca9548";
		i2c-mux-idle-disconnect;
		reg = <0x74>;

		i2c4_71_74_chan0: i2c@0 {
			reg = <0>;
			sensor11@psu1_5b {
				compatible = "edge-core,ir3570";
				reg = <0x5b>;
			};
			eepromPSU1@53 {
				compatible = "atmel,24c02";
				reg = <0x53>;
			};
		};

		i2c4_71_74_chan1: i2c@1 {
			reg = <1>;
			sensor12@psu2_58 {
				compatible = "edge-core,ir3570";
				reg = <0x58>;
			};
			eepromPSU2@50 {
				compatible = "atmel,24c02";
				reg = <0x50>;
			};
		};

		i2c4_71_74_chan2: i2c@2 {
			reg = <2>;
		};

		i2c4_71_74_chan3: i2c@3 {
			reg = <3>;
		};

		i2c4_71_74_chan4: i2c@4 {
			reg = <4>;
		};

		i2c4_71_74_chan5: i2c@5 {
			reg = <5>;
		};

		i2c4_71_74_chan6: i2c@6 {
			reg = <6>;
		};

		i2c4_71_74_chan7: i2c@7 {
			reg = <7>;
		};
	};
};

&i2c4_71_73_chan0 {
	i2c-mux5@75 {
		compatible = "nxp,pca9548";
		i2c-mux-idle-disconnect;
		reg = <0x75>;

		i2c4_71_73_75_chan0: i2c@0 {
			reg = <0>;
			eeprom@57 {
				compatible = "atmel,24c32";
				reg = <0x57>;
			};
		};

		i2c4_71_73_75_chan1: i2c@1 {
			reg = <1>;

			sensor1@lm75bd_5_main_48 {
				//compatible = "national,lm75";
				reg = <0x48>;
			};
		};

		i2c4_71_73_75_chan2: i2c@2 {
			reg = <2>;

			sensor2@lm75bd_6_main_4b {
				//compatible = "national,lm75";
				reg = <0x4b>;
			};
		};

		i2c4_71_73_75_chan3: i2c@3 {
			reg = <3>;

			sensor3@lm75bd_7_main_4d {
				//compatible = "national,lm75";
				reg = <0x4d>;
			};
		};

		i2c4_71_73_75_chan4: i2c@4 {
			reg = <4>;
		};

		i2c4_71_73_75_chan5: i2c@5 {
			reg = <5>;
		};

		i2c4_71_73_75_chan6: i2c@6 {
			reg = <6>;
		};

		i2c4_71_73_75_chan7: i2c@7 {
			reg = <7>;
		};
	};
};

&i2c4_71_73_chan7 {
	i2c-mux6@75 {
		compatible = "nxp,pca9548";
		status = "disabled";
		i2c-mux-idle-disconnect;
		reg = <0x75>;
	};
};


&ibt {
	status = "okay";
};

&uart1 {
	status = "okay";
	// Workaround for A0
	compatible = "snps,dw-apb-uart";
};

&uart2 {
	status = "okay";
};

&uart5 {
	// Workaround for A0
	compatible = "snps,dw-apb-uart";
};

&vuart1 {
	status = "okay";
};

&vuart2 {
	status = "okay";
};

&lpc_ctrl {
	status = "okay";
	memory-region = <&flash_memory>;
	flash = <&spi1>;
};

&lpc_snoop {
	status = "okay";
	snoop-ports = <0x80>;
};

&wdt1 {
	aspeed,reset-type = "none";
	aspeed,external-signal;
	aspeed,ext-push-pull;
	aspeed,ext-active-high;

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_wdtrst1_default>;
};


&wdt2 {
	status = "okay";
};


&pinctrl {
	/* Hog these as no driver is probed for the entire LPC block */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpc_default>,
		    <&pinctrl_lsirq_default>;
};

&xdma {
	status = "okay";
	memory-region = <&vga_memory>;
};

&lpc_host {
       kcs4: kcs4@0 {
               compatible = "openbmc,mctp-lpc";
               interrupts = <GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>;
               status = "okay";
       };
};

&kcs2 {
	// BMC KCS channel 2
	status = "okay";
};

&kcs3 {
	// BMC KCS channel 3
	status = "okay";
	kcs_addr = <0xca2>;
};

&peci0 {
	status = "okay";
};
