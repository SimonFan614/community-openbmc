#!/bin/bash

GPIOO2_BMC_SPI_MUX_SEL=418

echo $GPIOO2_BMC_SPI_MUX_SEL > /sys/class/gpio/export
echo 0 > /sys/class/gpio/gpio"$GPIOO2_BMC_SPI_MUX_SEL"/active_low
echo out > /sys/class/gpio/gpio"$GPIOO2_BMC_SPI_MUX_SEL"/direction
echo none > /sys/class/gpio/gpio"$GPIOO2_BMC_SPI_MUX_SEL"/edge
echo 1 > /sys/class/gpio/gpio"$GPIOO2_BMC_SPI_MUX_SEL"/value
